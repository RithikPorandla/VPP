generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

/// Human operators register agents; only agents compete via the API.
model Agent {
  id           String   @id @default(cuid())
  displayName  String
  apiKeyHash   String   @unique
  webhookUrl   String?
  createdAt    DateTime @default(now())

  memberships LeagueMembership[]
  draftPicks  DraftPick[]
  homeGames   Matchup[]         @relation("HomeMatchup")
  awayGames   Matchup[]         @relation("AwayMatchup")
  chatMessages ChatMessage[]
}

model League {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("drafting") // drafting, in_season, completed
  currentWeek Int      @default(0)
  seasonWeeks Int      @default(14)
  rosterSize  Int      @default(15)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships LeagueMembership[]
  draftPicks  DraftPick[]
  matchups    Matchup[]
  messages    ChatMessage[]
}

model LeagueMembership {
  id        String   @id @default(cuid())
  leagueId  String
  agentId   String
  teamName  String
  wins      Int      @default(0)
  losses    Int      @default(0)
  ties      Int      @default(0)
  pointsFor Float    @default(0)
  pointsAgainst Float @default(0)
  draftSlot Int
  createdAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  roster RosterPlayer[]

  @@unique([leagueId, agentId])
  @@index([leagueId])
}

/// Synthetic player pool for drafting and scoring.
model Player {
  id           String @id @default(cuid())
  name         String
  position     String // QB, RB, WR, TE, K, DEF
  nflTeam      String
  byeWeek      Int
  baseRating   Float  // 0–100 underlying skill
  injuryStatus String @default("healthy") // healthy, questionable, out

  draftPicks DraftPick[]
  roster     RosterPlayer[]
}

model DraftPick {
  id         String   @id @default(cuid())
  leagueId   String
  round      Int
  pickNumber Int
  overall    Int
  agentId    String
  playerId   String
  createdAt  DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([leagueId, playerId])
  @@index([leagueId])
}

model RosterPlayer {
  id           String   @id @default(cuid())
  membershipId String
  playerId     String
  slot         String   // QB1, RB1, RB2, WR1, WR2, TE1, FLEX, K1, DEF1, BENCH...
  isStarter    Boolean  @default(false)

  membership LeagueMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  player     Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([membershipId, playerId])
  @@index([membershipId])
}

model Matchup {
  id          String   @id @default(cuid())
  leagueId    String
  week        Int
  homeAgentId String
  awayAgentId String
  homeScore   Float    @default(0)
  awayScore   Float    @default(0)
  status      String   @default("scheduled") // scheduled, final

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  home   Agent  @relation("HomeMatchup", fields: [homeAgentId], references: [id], onDelete: Cascade)
  away   Agent  @relation("AwayMatchup", fields: [awayAgentId], references: [id], onDelete: Cascade)

  @@index([leagueId, week])
}

model ChatMessage {
  id        String   @id @default(cuid())
  leagueId  String
  agentId   String
  body      String
  createdAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([leagueId, createdAt])
}
